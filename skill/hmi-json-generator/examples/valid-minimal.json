  "htmlCode": {
    "codeHeadValue": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>第三方数据展示区</title>\n<style>\n  * {\n    box-sizing: border-box;\n  }\n\n  body {\n    margin: 0;\n    min-height: 100vh;\n    padding: 24px;\n    font-family: Arial, \"Microsoft YaHei\", sans-serif;\n    background: #f1f5f9;\n    color: #334155;\n  }\n\n  .external-data-panel {\n    width: 100%;\n    min-height: calc(100vh - 48px);\n    padding: 24px;\n    border: 1px solid #d9e2ec;\n    border-radius: 8px;\n    background: #f8fafc;\n  }\n\n  .external-data-panel h2 {\n    margin: 0 0 18px;\n    font-size: 22px;\n  }\n\n  .card-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 16px;\n  }\n\n  .card {\n    min-height: 140px;\n    padding: 18px;\n    border-radius: 6px;\n    background: #ffffff;\n    border: 1px solid #e2e8f0;\n  }\n\n  .card-title {\n    color: #64748b;\n    font-size: 13px;\n  }\n\n  .card-value {\n    margin-top: 12px;\n    color: #1e293b;\n    font-size: 22px;\n    font-weight: 700;\n  }\n\n  .tag {\n    display: inline-block;\n    margin-top: 18px;\n    padding: 5px 8px;\n    border-radius: 4px;\n    background: #e0f2fe;\n    color: #0369a1;\n    font-size: 12px;\n  }\n\n  @media (max-width: 700px) {\n    .card-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n</head>",
    "codeBodyValue": "<body>\n  <main class=\"external-data-panel\">\n    <h2>第三方数据展示区</h2>\n    <section class=\"card-grid\">\n      <div class=\"card\">\n        <div class=\"card-title\">MES 计划完成率</div>\n        <div id=\"plan-rate\" class=\"card-value\">--</div>\n      </div>\n      <div class=\"card\">\n        <div class=\"card-title\">摄像头连接状态</div>\n        <div id=\"camera-status\" class=\"card-value\">接口待配置</div>\n      </div>\n      <div class=\"card\">\n        <div class=\"card-title\">外部 API 数据</div>\n        <div id=\"api-status\" class=\"card-value\">模拟预览</div>\n      </div>\n    </section>\n    <span class=\"tag\">不读取、不写入、不同步现场 PLC 变量</span>\n  </main>\n\n  <script>\n    document.getElementById('plan-rate').innerText = '模拟数据';\n  </script>\n</body>\n</html>"
  }
