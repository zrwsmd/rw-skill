{
  "schemaName": "hmi-json-generator-strict-html",
  "rootAllowed": [
    "type",
    "id",
    "name",
    "size",
    "backgroundColor",
    "children",
    "htmlCode"
  ],
  "htmlCode": {
    "optional": true,
    "allowedFields": [
      "codeHeadValue",
      "codeBodyValue"
    ],
    "fieldType": "string",
    "supportsCommonHtml": true,
    "supportsFullHtmlDocument": true,
    "supportsInlineScript": true,
    "supportsExternalScriptSrc": true,
    "supportsIframe": true
  },
  "forbiddenAnywhere": [
    "w",
    "h",
    "style",
    "binding",
    "background",
    "textColor",
    "foregroundColor"
  ],
  "nesting": {
    "graphChildren": "all registered native types except node:tab",
    "tabViewChildren": [
      "node:tab"
    ],
    "tabChildren": "all registered native types except node:tab",
    "containerChildrenForbidden": true
  },
  "pathConstraints": {
    "segmentsLengthEqualsPointsLength": true,
    "firstSegment": 1,
    "remainingSegments": 2,
    "flowDirections": [
      "forward",
      "backward"
    ]
  },
  "bindings": {
    "unverifiedVariableName": "",
    "unverifiedVariableType": "",
    "boolTypes": [
      "BOOL"
    ],
    "integerTypes": [
      "BYTE",
      "WORD",
      "DWORD",
      "LWORD",
      "SINT",
      "USINT",
      "INT",
      "UINT",
      "DINT",
      "UDINT",
      "LINT"
    ],
    "numberInputAdditionalTypes": [
      "REAL",
      "LREAL"
    ],
    "textareaType": "STRING"
  },
  "resources": {
    "lightBackgroundImage": [
      "Green",
      "Gray"
    ],
    "flowImage": [
      "./img/radioCkecked.png"
    ]
  },
  "nativeTypeAndFieldWhitelist": "See references/schema.md section 6."
}