{
  "schemaName": "hmi-json-generator-strict-html-mixed-independent-layers",
  "rootAllowed": [
    "type",
    "id",
    "name",
    "size",
    "backgroundColor",
    "children",
    "htmlCode"
  ],
  "rootRequired": ["type", "id", "name", "size", "backgroundColor", "children"],
  "rootFixedValues": {
    "type": "graph",
    "id": "graph",
    "name": "screen"
  },
  "layoutPolicy": {
    "rootSizeWhenUserUnspecified": "infer-from-content-box-and-symmetric-safe-area",
    "rendererTransform": {
      "defaultZoom": 1,
      "zoomIsUniform": true,
      "positionsAndSizesAreZoomIndependent": true
    },
    "contentBox": {
      "centerInCanvas": true,
      "symmetricSafeArea": true,
      "safeInsetRatio": 0.04,
      "minimumInsetX": 24,
      "minimumInsetY": 24,
      "roundingTolerance": 1,
      "excludeFullCanvasBackground": true,
      "criticalContentMustStayInside": true,
      "criticalContentTypes": [
        "text",
        "output",
        "input",
        "numberInput",
        "textarea",
        "select",
        "button",
        "checkbox",
        "switch",
        "light",
        "progress",
        "arc",
        "arcSlider",
        "meter180",
        "meter360",
        "barDisplay",
        "trace",
        "xyChart",
        "table"
      ],
      "equalHorizontalInsets": true,
      "equalVerticalInsets": true
    },
    "viewportUnknownFallback": "content-fit-and-center",
    "jsonBoundsDoNotProveHostVisibility": true,
    "forbiddenCropFixes": [
      "infer-root-size-from-monitor-or-screenshot",
      "change-root-size-without-recomputing-layout-and-center",
      "uniformly-scale-all-existing-nodes",
      "single-edge-translate-as-crop-fix",
      "encode-screen-zoom-in-node-coordinates",
      "infer-graph-coordinates-from-screenshot-with-unknown-transform"
    ]
  },
  "htmlCode": {
    "optional": true,
    "allowedFields": ["codeHeadValue", "codeBodyValue"],
    "fieldType": "string",
    "supportsCommonHtml": true,
    "supportsFullHtmlDocument": true,
    "supportsInlineScript": true,
    "supportsExternalScriptSrc": true,
    "supportsIframe": true,
    "supportsNativeChildrenAndHtmlCodeTogether": true,
    "renderLayer": "html",
    "independentRenderLayers": true,
    "sameVisualLayerAsNativeChildren": false,
    "sharesNativeCoordinateSystem": false,
    "mustAssumeOtherLayerAbsentDuringGeneration": true,
    "mayReferenceOtherLayerLayout": false,
    "mayReserveSpaceForOtherLayer": false,
    "mayCoordinateCrossLayerLayout": false,
    "usesOwnFullAvailableArea": true,
    "requiresCrossLayerCollisionCheck": false,
    "requiresCrossLayerOcclusionCheck": false,
    "requiresCrossLayerClickConflictCheck": false,
    "requiresCrossLayerScrollConflictCheck": false,
    "requiresFixedMixedLayoutPartition": false,
    "supportsPlcVariableBinding": false,
    "supportsNativeComponentVariableAccess": false,
    "supportsPlcVariableRead": false,
    "supportsPlcVariableWrite": false,
    "supportsThirdPartyApiIntegration": true,
    "thirdPartyApiRequiresUserConfiguration": true
  },
  "nativeChildren": {
    "renderLayer": "native",
    "independentRenderLayers": true,
    "sameVisualLayerAsHtmlCode": false,
    "sharesHtmlCoordinateSystem": false,
    "mustAssumeOtherLayerAbsentDuringGeneration": true,
    "mayReferenceOtherLayerLayout": false,
    "mayReserveSpaceForOtherLayer": false,
    "mayCoordinateCrossLayerLayout": false,
    "usesOwnFullAvailableArea": true,
    "requiresCrossLayerCollisionCheck": false,
    "requiresCrossLayerOcclusionCheck": false,
    "requiresCrossLayerClickConflictCheck": false,
    "requiresCrossLayerScrollConflictCheck": false
  },
  "forbiddenAnywhere": [
    "w",
    "h",
    "style",
    "binding",
    "background",
    "textColor",
    "foregroundColor"
  ],
